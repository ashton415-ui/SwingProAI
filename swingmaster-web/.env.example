# Copy this file to .env.local and fill in real values.
# Use the same Supabase project as the main app.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini — from aistudio.google.com (same key as main app)
GEMINI_API_KEY=

# Site URL — local dev or Vercel URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
