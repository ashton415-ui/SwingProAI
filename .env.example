# Supabase — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — from Stripe Dashboard > Developers > API Keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — from Stripe Dashboard > Products
STRIPE_PAR_PRICE_ID=
STRIPE_BIRDIE_PRICE_ID=
STRIPE_EAGLE_PRICE_ID=

# Site URL — your Vercel production URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# AI Backend — Python FastAPI URL (set when backend is deployed)
AI_BACKEND_URL=

# Gemini AI — from aistudio.google.com
GEMINI_API_KEY=

# Gemini model routing (defaults used if not set)
GEMINI_BASIC_MODEL=local-basic
GEMINI_ADVANCED_MODEL=gemini-2.5-flash
GEMINI_ULTRA_MODEL=gemini-2.5-pro
